{
  "name": "@mukeshsoni/react-image-editor",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "A Lightroom-style, non-destructive image editor for React (canvas-based).",
  "homepage": "https://github.com/mukeshsoni/react-image-editor#readme",
  "keywords": [
    "react",
    "image",
    "editor",
    "canvas",
    "crop",
    "lightroom"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mukeshsoni/react-image-editor.git"
  },
  "bugs": {
    "url": "https://github.com/mukeshsoni/react-image-editor/issues"
  },
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "prepack": "npm run build:lib && npm run build:types",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.513.0",
    "react-resizable-panels": "^3.0.2",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.4",
    "zustand": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": ">=3.3.0 <5"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@simbathesailor/use-what-changed": "^2.0.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.8",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}
