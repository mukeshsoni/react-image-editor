{
  "name": "@mukeshsoni/react-image-editor",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "A Lightroom-style, non-destructive image editor for React (canvas-based).",
  "homepage": "https://github.com/mukeshsoni/react-image-editor#readme",
  "keywords": [
    "react",
    "image",
    "editor",
    "canvas",
    "crop",
    "lightroom"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mukeshsoni/react-image-editor.git"
  },
  "bugs": {
    "url": "https://github.com/mukeshsoni/react-image-editor/issues"
  },
  "scripts": {
    "test": "vitest",
    "test:css": "npm run build:css && node --test css-regression/scope.test.mjs",
    "test:css:package": "node css-regression/packed-consumer.mjs",
    "test:review": "npm run build:css && playwright test -c playwright.review.config.ts",
    "typecheck:review": "tsc -p tsconfig.review.json",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:package": "npm run build:lib && npm run build:types && node e2e/scripts/prepare-consumers.mjs && playwright test -c playwright.package.config.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "dev": "node scripts/build-css.mjs --dev",
    "build": "npm run build:css && vite build",
    "build:css": "node scripts/build-css.mjs",
    "build:lib": "npm run build:css && vite build -c vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "prepack": "npm run build:lib && npm run build:types",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.513.0",
    "react-compiler-runtime": "19.1.0-rc.2",
    "react-resizable-panels": "^3.0.2",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.18.0",
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.8",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}
